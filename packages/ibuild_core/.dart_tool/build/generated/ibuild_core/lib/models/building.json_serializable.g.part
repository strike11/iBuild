// **************************************************************************
// JsonSerializableGenerator
// **************************************************************************

_Building _$BuildingFromJson(Map<String, dynamic> json) => _Building(
  id: json['id'] as String,
  projectId: json['projectId'] as String,
  name: json['name'] as String,
  floors: (json['floors'] as num).toInt(),
  constructionProgress: (json['constructionProgress'] as num?)?.toInt(),
  completionDate: json['completionDate'] == null
      ? null
      : DateTime.parse(json['completionDate'] as String),
  units:
      (json['units'] as List<dynamic>?)
          ?.map((e) => Unit.fromJson(e as Map<String, dynamic>))
          .toList() ??
      const <Unit>[],
);

Map<String, dynamic> _$BuildingToJson(_Building instance) => <String, dynamic>{
  'id': instance.id,
  'projectId': instance.projectId,
  'name': instance.name,
  'floors': instance.floors,
  'constructionProgress': instance.constructionProgress,
  'completionDate': instance.completionDate?.toIso8601String(),
  'units': instance.units,
};
