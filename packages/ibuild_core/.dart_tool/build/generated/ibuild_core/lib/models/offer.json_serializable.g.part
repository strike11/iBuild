_Offer _$OfferFromJson(Map<String, dynamic> json) => _Offer(
  id: json['id'] as String,
  projectId: json['projectId'] as String,
  type: $enumDecode(_$OfferTypeEnumMap, json['type']),
  title: json['title'] as String,
  description: json['description'] as String?,
  startsAt: json['startsAt'] == null
      ? null
      : DateTime.parse(json['startsAt'] as String),
  endsAt: json['endsAt'] == null
      ? null
      : DateTime.parse(json['endsAt'] as String),
  downPaymentPercent: (json['downPaymentPercent'] as num?)?.toDouble(),
  termMonths: (json['termMonths'] as num?)?.toInt(),
  interestRate: (json['interestRate'] as num?)?.toDouble(),
);

Map<String, dynamic> _$OfferToJson(_Offer instance) => <String, dynamic>{
  'id': instance.id,
  'projectId': instance.projectId,
  'type': _$OfferTypeEnumMap[instance.type]!,
  'title': instance.title,
  'description': instance.description,
  'startsAt': instance.startsAt?.toIso8601String(),
  'endsAt': instance.endsAt?.toIso8601String(),
  'downPaymentPercent': instance.downPaymentPercent,
  'termMonths': instance.termMonths,
  'interestRate': instance.interestRate,
};

const _$OfferTypeEnumMap = {
  OfferType.discount: 'discount',
  OfferType.installment: 'installment',
  OfferType.rentPromo: 'rent_promo',
};
