# =============================================================================
# iBuild API — environment template
# =============================================================================
# Copy to `.env` (never commit `.env`):
#   cp .env.example .env
#
# Real OS/environment variables always override values in this file.
# For aHOST.uz production: see docs/HOSTING_AHOST.md

# --- Runtime mode -----------------------------------------------------------
# development (default) | production
# production disables fixed OTP 123456, free checkout, and refuses to start
# unless the required secrets below are set.
# APP_ENV=production

# --- Listen -----------------------------------------------------------------
# Behind nginx/Caddy on aHOST VDS, bind loopback only:
# BIND_ADDRESS=127.0.0.1
# PORT=4000
BIND_ADDRESS=0.0.0.0
PORT=4000

# --- Reverse proxy ----------------------------------------------------------
# Rate limiting keys off the client IP. Leave false when the API is reachable
# directly: X-Forwarded-For is attacker-controlled, and trusting it lets one
# client mint a fresh bucket per request and brute-force OTP codes.
# Set true ONLY behind a proxy that OVERWRITES the header, e.g. nginx with
#   proxy_set_header X-Forwarded-For $remote_addr;
# REQUIRED (true) in production when BIND_ADDRESS is loopback, and always when
# running in Docker — otherwise every request looks like it came from one
# address and the whole internet shares a single rate-limit bucket. The server
# refuses to start in production in either case without it.
TRUST_PROXY=false

# --- PostgreSQL -------------------------------------------------------------
# Local portable/docker defaults (match docker-compose.yml / db-local.ps1).
# On aHOST: use the Managed PostgreSQL host from the control panel.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ibuild
DB_USER=ibuild
# SECURITY: override before any shared/production use. Production refuses
# changeme / CHANGE_ME_* passwords.
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# true for remote/managed Postgres (aHOST). false only for loopback DB.
DB_SSL=false

# --- SMS (Eskiz.uz) ---------------------------------------------------------
# Unset → fixed OTP 123456 logged to stderr (dev ONLY).
# REQUIRED when APP_ENV=production: either ESKIZ_TOKEN, or the email+password
# pair (the server logs in and refreshes the token automatically).
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_TOKEN=
# Approved sender ID. The default 4546 is Eskiz's shared TEST sender and only
# delivers to numbers allow-listed in your Eskiz account — set your own before
# real users sign up, or every OTP is silently dropped by the provider.
# ESKIZ_FROM=4546

# --- Platform operators -----------------------------------------------------
# Comma-separated phones always seeded as system_admin.
# REQUIRED when APP_ENV=production (no hardcoded default).
# SYSTEM_ADMIN_PHONES=+998901234567

# --- Bootstrap / checkout (keep OFF in production) --------------------------
# BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# ALLOW_DEV_CHECKOUT=false

# --- CORS -------------------------------------------------------------------
# REQUIRED when APP_ENV=production — your real HTTPS web origins (no *).
# ALLOWED_ORIGINS=https://app.ibuild.uz,https://admin.ibuild.uz

# --- Demo safety ------------------------------------------------------------
# Random unit status flips every 8s — OFF unless explicitly enabled.
# Leave false/unset for investor demos (your "Sold" click stays the hero).
LIVE_DEMO_TICKER=false
# Auto-accept KYC docs + construction photo reports on the first showcase
# project at boot (Verified badge + Progress tab). Safe for local demos only.
DEMO_STAGE_TRUST=true
# Local bootstrap-admin secret (never use ibuild-dev — server rejects it).
BOOTSTRAP_ADMIN_SECRET=ibuild-local-demo-secret
