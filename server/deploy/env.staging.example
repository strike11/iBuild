# Staging on a bare IP (no TLS, no Eskiz yet).
# Copied to /opt/ibuild/server/.env by setup-docker-server.sh — edit there on the VDS.
#
# OTP without SMS: always 123456 (logged to `docker compose logs api`).
# Do NOT use APP_ENV=production until Eskiz credentials are configured.

APP_ENV=staging

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ibuild
DB_USER=ibuild
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_SSL=false

# Required behind nginx (loopback bind in docker-compose.yml).
TRUST_PROXY=true

# Replace YOUR_SERVER_IP with the VDS public address.
ALLOWED_ORIGINS=http://YOUR_SERVER_IP,http://YOUR_SERVER_IP:8080

# First admin — or use POST /v1/platform/bootstrap-admin in staging.
SYSTEM_ADMIN_PHONES=+998901234567
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

ALLOW_DEV_CHECKOUT=false
LIVE_DEMO_TICKER=false
DEMO_STAGE_TRUST=false

# --- AI layer (OpenAI) -------------------------------------------------------
# NOT set by setup-docker-server.sh — add these by hand after first deploy,
# same as DB_PASSWORD/BOOTSTRAP_ADMIN_SECRET above. Skipping this section is
# exactly the incident from 2026-09-12: the API stays perfectly healthy
# (/v1/health is unaffected) while the A→B construction-verify pipeline
# silently never calls OpenAI and every cycle lands on `needs_review`.
#
# After editing, verify BOTH switches are on with:
#   docker compose -f /opt/ibuild/deploy/docker-compose.yml restart api
#   bash /opt/ibuild/deploy/healthcheck-ai.sh
# (constructionVerifyReady must be true — see GET /v1/platform/ai/status.)
AI_ENABLED=true
AI_VISION_ENABLED=true
# OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-5.6-luna
AI_QUOTA_SALT=CHANGE_ME_RANDOM_STRING
AI_CHAT_DAILY_LIMIT=5
AI_SEARCH_HOURLY_LIMIT=60
AI_VERIFY_DAILY_LIMIT=100
AI_DAILY_GLOBAL_LIMIT=20
# Switch #2 — the construction-verify prompt itself. The image only ships the
# committed PROMPT_NOT_SHIPPED placeholder (lib/ is not copied into the
# runtime stage; see server/Dockerfile), so vision stays a no-op until a real
# prompt file is mounted. docker-compose.yml already bind-mounts
# /opt/ibuild/server/prompts -> /app/prompts:ro — drop the real prompt at
# /opt/ibuild/server/prompts/construction_verify_v0.system.txt (chmod 644,
# world-readable: the container runs as uid 10001, not `ubuntu`) and point
# this at the mounted path:
CONSTRUCTION_VERIFY_PROMPT_FILE=/app/prompts/construction_verify_v0.system.txt
