# Staging on a bare IP (no TLS, no Eskiz yet).
# Copied to /opt/ibuild/server/.env by setup-docker-server.sh — edit there on the VDS.
#
# OTP without SMS: always 123456 (logged to `docker compose logs api`).
# Do NOT use APP_ENV=production until Eskiz credentials are configured.

APP_ENV=staging

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ibuild
DB_USER=ibuild
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_SSL=false

# Required behind nginx (loopback bind in docker-compose.yml).
TRUST_PROXY=true

# Replace YOUR_SERVER_IP with the VDS public address.
ALLOWED_ORIGINS=http://YOUR_SERVER_IP,http://YOUR_SERVER_IP:8080

# First admin — or use POST /v1/platform/bootstrap-admin in staging.
SYSTEM_ADMIN_PHONES=+998901234567
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

ALLOW_DEV_CHECKOUT=false
LIVE_DEMO_TICKER=false
DEMO_STAGE_TRUST=false
